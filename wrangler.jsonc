{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "COOKIE_SECURE": "true",
    "DEFAULT_SOURCES": "[{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"非凡资源\",\"url\":\"https://cj.ffzyapi.com/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"量子资源\",\"url\":\"https://cj.lziapi.com/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"无尽资源\",\"url\":\"https://api.wujinapi.me/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"360资源\",\"url\":\"https://360zy.com/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"光速资源\",\"url\":\"https://api.guangsuapi.com/api.php/provide/vod\",\"isAdult\":false}]"
  }
}
