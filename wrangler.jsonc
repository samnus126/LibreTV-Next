{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "COOKIE_SECURE": "true",
    "DEFAULT_SOURCES": "[{\"key\":\"env_0\",\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"isAdult\":false},{\"key\":\"env_1\",\"name\":\"非凡资源\",\"url\":\"https://cj.ffzyapi.com/api.php/provide/vod\",\"isAdult\":false},{\"key\":\"env_2\",\"name\":\"量子资源\",\"url\":\"https://cj.lziapi.com/api.php/provide/vod\",\"isAdult\":false},{\"key\":\"env_5\",\"name\":\"光速资源\",\"url\":\"https://api.guangsuapi.com/api.php/provide/vod\",\"isAdult\":false},{\"key\":\"env_7\",\"name\":\"iKun资源\",\"url\":\"https://ikunzyapi.com/api.php/provide/vod\",\"isAdult\":false},{\"key\":\"env_8\",\"name\":\"魔都\",\"url\":\"https://caiji.moduapi.cc/api.php/provide/vod/\",\"isAdult\":false},{\"key\":\"env_9\",\"name\":\"红牛\",\"url\":\"http://hongniuzy2.com/api.php/provide/vod/from/hnm3u8\",\"isAdult\":false},{\"key\":\"env_10\",\"name\":\"虎牙资源\",\"url\":\"https://www.huyaapi.com/api.php/provide/vod/\",\"isAdult\":false}]",
    "DEFAULT_LIVE_SOURCES": "[{\"name\":\"IPTV4\",\"url\":\"https://gh-proxy.com/raw.githubusercontent.com/vbskycn/iptv/refs/heads/master/tv/iptv4.m3u\"},{\"name\":\"香港电视（IPTV-org）\",\"url\":\"https://iptv-org.github.io/iptv/countries/hk.m3u\"}]"
  }
}
